{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "sql:default",
    "sql:allow-execute",
    "log:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$APPCONFIG/backups" }] },
    { "identifier": "fs:allow-read-dir", "allow": [{ "path": "$APPCONFIG/backups" }] },
    { "identifier": "fs:allow-stat", "allow": [{ "path": "$APPCONFIG/backups/*" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$APPCONFIG/backups/*" }] },
    "core:webview:allow-print"
  ]
}
