{
  "name": "inkwell",
  "private": true,
  "version": "0.0.0",
  "description": "A fast, minimal, local-first desktop word processor with a weekly writing streak.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smoothjerry/inkwell.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check",
    "format": "biome check --write",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  }
}
